<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SampleApp.Views"
        x:Class="SampleApp.MainWindow"
        Title="SampleApp" Width="600" Height="420">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" Spacing="8">
            <TextBlock Text="Sample App"
                       AutomationProperties.AutomationId="MainWindow_Title_Label"
                       FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Login"
                    AutomationProperties.AutomationId="MainWindow_Login_Nav"/>
            <Button Content="Settings"
                    AutomationProperties.AutomationId="MainWindow_Settings_Nav"/>
        </StackPanel>

        <TabControl Margin="8">
            <TabItem Header="Login">
                <views:LoginView/>
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
